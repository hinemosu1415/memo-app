{
  "name": "memo-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch workspaces/server/index.ts",
    "dev:client": "vite --host localhost",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/valibot-validator": "0.6.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.12.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.0",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.1"
  }
}
